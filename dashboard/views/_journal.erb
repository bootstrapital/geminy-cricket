<% if entries.empty? %>
  <p>No journal entries yet.</p>
<% else %>
  <% entries.each do |entry| %>
    <article>
      <header>
        <strong><%= entry["entry_type"] %></strong>
        <small><%= entry["timestamp"] %></small>
      </header>
      <pre><%= entry["content"] %></pre>
    </article>
  <% end %>
<% end %>
